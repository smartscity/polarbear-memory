{
  "title": "Polarbear Memory Local Admin API",
  "version": "1.2",
  "engineVersion": "0.1.0",
  "transport": "user-scoped-unix-domain-socket",
  "maxFrameBytes": 1048576,
  "capabilities": [
    "projects.status",
    "system.shutdown",
    "memories.list",
    "memories.get",
    "memories.record",
    "memories.history",
    "memories.update",
    "memories.verify",
    "memories.archive",
    "memories.restore",
    "memories.complete",
    "memories.feedback",
    "memories.relate",
    "memories.purge_preview",
    "memories.purge",
    "contexts.explain",
    "usage.token_savings",
    "usage.token_savings_reset",
    "projects.diagnostics",
    "projects.config",
    "projects.config_update",
    "maintenance.preview",
    "maintenance.run",
    "backups.list",
    "backups.create",
    "backups.verify",
    "backups.restore_preview",
    "backups.restore",
    "knowledge.promote_preview",
    "knowledge.promote"
  ],
  "security": {
    "tcp": false,
    "tokenFileMode": "0600",
    "socketMode": "0600",
    "directoryMode": "0700",
    "databasePathExposed": false
  }
}
