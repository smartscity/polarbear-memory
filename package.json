{
  "name": "polarbear-memory",
  "version": "0.0.4",
  "private": true,
  "description": "Local-first persistent memory for coding agents",
  "type": "module",
  "bin": {
    "polarbear-memory": "./dist/cli.js"
  },
  "engines": {
    "node": ">=24.10.0 <27"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node --run clean:dist",
    "clean:dist": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "start": "node dist/cli.js",
    "test": "npm run build && node --test --test-concurrency=1 dist/*.test.js dist/**/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "licenses:check": "node scripts/licenses-check.mjs",
    "dependencies:check": "node scripts/runtime-audit.mjs",
    "bundle:audit": "npm run build && node scripts/runtime-audit.mjs --scan-dist",
    "check": "npm run typecheck && npm test && npm run licenses:check && npm run dependencies:check && npm run bundle:audit"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.2.0"
  }
}
