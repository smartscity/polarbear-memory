{
  "name": "polarbear-memory",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first persistent memory for coding agents",
  "type": "module",
  "bin": {
    "polarbear-memory": "./dist/cli.js"
  },
  "engines": {
    "node": ">=24.10.0 <27"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node --run clean:dist",
    "clean:dist": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "start": "node dist/cli.js",
    "test": "npm run build && node --test --test-concurrency=1 dist/*.test.js dist/**/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "licenses:check": "node scripts/licenses-check.mjs",
    "dependencies:check": "node scripts/runtime-audit.mjs",
    "bundle:audit": "npm run build && node scripts/runtime-audit.mjs --scan-dist",
    "format:check": "node scripts/format-check.mjs",
    "admin-contract:check": "node scripts/check-admin-contract.mjs",
    "lint": "npm run typecheck && node scripts/runtime-audit.mjs --scan-source",
    "advisories:check": "npm audit --audit-level=high",
    "sbom:generate": "node scripts/generate-sbom.mjs",
    "sbom:check": "node scripts/generate-sbom.mjs --check",
    "benchmark:ga": "npm run build && node scripts/ga-readiness.mjs",
    "release:macos": "node scripts/build-macos-release.mjs",
    "release:macos:unsigned": "node scripts/build-macos-release.mjs --unsigned",
    "check": "npm run format:check && npm run lint && npm run admin-contract:check && npm test && npm run licenses:check && npm run dependencies:check && npm run bundle:audit && npm run sbom:check && npm run benchmark:ga",
    "release:check": "npm ci --ignore-scripts && npm run check && npm run advisories:check"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.2.0"
  }
}
