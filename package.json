{
  "name": "polarbear-memory",
  "version": "0.0.1",
  "private": true,
  "description": "Local-first persistent memory for coding agents",
  "type": "module",
  "bin": {
    "polarbear-memory": "./dist/cli.js"
  },
  "engines": {
    "node": ">=24.10.0 <27"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node --run clean:dist",
    "clean:dist": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "start": "node dist/cli.js",
    "test": "npm run build && node --test dist/*.test.js dist/**/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  },
  "license": "UNLICENSED"
}
